---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NextCard from '../../components/NextCard.astro';
import { getChapters, chapterLabel } from '../../lib/chapters';

export async function getStaticPaths() {
  const chapters = await getChapters();
  return chapters.map((chapter, i) => ({
    params: { slug: chapter.id },
    props: { chapter, prev: chapters[i - 1], next: chapters[i + 1] },
  }));
}

const { chapter, prev, next } = Astro.props;
const { Content } = await render(chapter);
---

<Base title={chapter.data.title} description={chapter.data.deck} currentChapterId={chapter.id}>
  <article class="page">
    <p class="eyebrow">{chapterLabel(chapter)}</p>
    <h1 class="chapter-title">{chapter.data.title}</h1>
    <p class="deck">{chapter.data.deck}</p>

    {
      chapter.data.stub && (
        <div class="stub-note">
          <strong>Not written yet.</strong> This chapter is planned and its place in the book is fixed. Below is
          where it is headed.
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <NextCard prev={prev} next={next} />
  </article>

  <script>
    import '../../components/interactives/index.js';
  </script>
</Base>
